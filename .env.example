# Copy this file to .env and fill in values for local development.

# Path to the SQLite catalog file. Optional; defaults to ./kessler.db.
# KESSLER_DB_PATH=kessler.db

# Comma-separated list of API keys. When set, every endpoint except /health
# requires an `X-API-Key` header matching one of these keys. When unset (the
# default), the API stays open — convenient for local development, but do
# not deploy publicly without setting this.
# KESSLER_API_KEYS=dev-key-1,dev-key-2

# Placeholder for future secrets (e.g. Space-Track credentials).
