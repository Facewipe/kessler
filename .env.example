# Copy this file to .env and fill in values for local development.

# Path to the SQLite database file. Defaults to kessler.db in the working
# directory when unset.
KESSLER_DB_PATH=kessler.db

# Comma-separated list of accepted API keys. When set, every endpoint except
# /health requires a matching X-API-Key header (401 otherwise). Leave unset
# (or delete this line) to keep the API open for local development.
# KESSLER_API_KEYS=dev-key-1,dev-key-2

# When the app is running, it auto-ingests on startup if the catalog is
# empty and every 12 hours after that. Set to 0 to disable (e.g. in tests).
# KESSLER_AUTO_INGEST=1
