# Copy this file to .env and fill in values for local development.

# Path to the SQLite catalog file. Defaults to ./kessler.db if unset.
KESSLER_DB_PATH=kessler.db

# Comma-separated list of accepted X-API-Key values. If unset, the API is
# open (dev mode) and every endpoint except /health requires no key.
# KESSLER_API_KEYS=dev-key-1,dev-key-2

# Placeholder for future secrets (e.g. Space-Track credentials).
